{
  "name": "coderabbit-triage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser extension that turns CodeRabbit review comments into a triage worklist on GitHub pull requests.",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "happy-dom": "^20.11.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
